# --- Octopus Energy (Kraken) API -------------------------------------------
# Portal-Login (E-Mail + Passwort) ...
OCTOPUS_EMAIL=you@example.org
OCTOPUS_PASSWORD=changeme
# ... oder alternativ ein API-Key aus dem Kundenportal
# OCTOPUS_API_KEY=
API_URL=https://api.oeg-kraken.energy/v1/graphql/
# Mindestabstand zwischen zwei API-Requests (die API drosselt stark)
API_MIN_INTERVAL_SECONDS=1.2

# --- Application -----------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
DB_URL=sqlite:///./data/o-energy.db
TIMEZONE=Europe/Berlin

# --- Polling ---------------------------------------------------------------
POLL_INTERVAL_MINUTES=15
READINGS_BACKFILL_DAYS=3
READINGS_HISTORY_DAYS=30
READINGS_MAX_WINDOW_DAYS=7
GAP_RETRY_MINUTES=60
PRICE_BACKFILL_HOURS=72
SLOT_MINUTES=15
SLOT_EXPECTED_TOLERANCE=0.9
FINALIZATION_GRACE_MINUTES=120
SCHEDULER_ENABLED=true

# --- Anmeldung -------------------------------------------------------------
# Hash erzeugen mit:  uv run oenergy set-password
AUTH_ENABLED=true
AUTH_USERNAME=admin
AUTH_LOCAL_BYPASS=true     # localhost/127.0.0.1 ohne Anmeldung (für Tests)
# AUTH_BYPASS_TOKEN=...    # optionales Secret-Header X-OEnergy-Token
# AUTH_PASSWORD_HASH=$argon2id$...
# AUTH_SECRET=...            # optional, sonst wird beim ersten Start erzeugt
SESSION_MAX_AGE_DAYS=14
COOKIE_SECURE=false          # true, wenn die App nur über HTTPS erreichbar ist

# --- MCP (nur lesender Zugriff für KI-Agenten) -----------------------------
# Ohne Token ist /mcp gesperrt (401). Token erzeugen mit:
#   uv run oenergy generate-mcp-token --write-env
# MCP_TOKEN=...
MCP_RATE_LIMIT_PER_MINUTE=120
MCP_MAX_BODY_BYTES=262144

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
# LOG_FILE=./data/logs/o-energy.log   # zusätzlich in eine Datei schreiben
LOG_ROTATION=10 MB
LOG_RETENTION=14 days

# --- Optional overrides ----------------------------------------------------
# ACCOUNT_NUMBER=A-12345678
# MELO_NUMBER=DE00012345678
# METER_ID=12345
# METER_OBIS=1-0:1.8.0
# ENERGY_UNIT=auto   # auto | kwh | wh

# --- Preiseinordnung (Preis-Matrix) ---------------------------------------
# Schwellen für die Farbgebung: grün (günstig) -> gelb (normal) -> rot (teuer)
PRICE_CHEAP_LIMIT=26.0
PRICE_EXPENSIVE_LIMIT=40.0
